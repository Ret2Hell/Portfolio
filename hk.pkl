amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

exclude = List(".mise/locks")

local checks = new Mapping<String, Step> {
  ["oxlint"] {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx")
    check = "oxlint {{files}}"
  }
  ["oxfmt"] {
    glob = List(
      "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json",
      "**/*.css", "**/*.md", "**/*.yml", "**/*.yaml", "**/*.toml"
    )
    check = "oxfmt --check {{files}}"
  }
}

steps = checks
